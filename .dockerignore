# Docker ignore file - excludes files from Docker build context

# Git
.git
.gitignore
.github

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.pytest_cache
.coverage
htmlcov
.tox
.venv
venv/
ENV/

# Data (will be mounted as volumes)
data/external/*.yaml
data/external/*.yml
data/processed/*.csv
data/raw/*

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# Tests (not needed in production)
tests/
.pytest_cache/

# CI/CD
.github/

# Temporary
*.tmp
*.log
tmp/
temp/
